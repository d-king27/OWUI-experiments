# Open WebUI image and host port
WEBUI_DOCKER_TAG=v0.11.0
OPEN_WEBUI_PORT=3000
WEBUI_AUTH=false

# Generate a unique value for local use. For example:
# python -c "import secrets; print(secrets.token_hex(32))"
WEBUI_SECRET_KEY=replace-with-a-long-random-value

# Script to Voice (start with docker compose --profile stv up -d --build)
STV_ENABLED=false
STV_MOCK=true
STV_LIVE_TESTS=false
STV_LIVE_ENABLED=false
# Generate a separate random token (at least 24 characters), shared only by Pipe/service.
STV_SERVICE_TOKEN=
ELEVENLABS_API_KEY=
# Real planning is separate from speech; hello-world is not an inference model.
STV_LLM_BASE_URL=
STV_LLM_PROVIDER=openai-compatible
STV_LLM_WORKSPACE_ID=
STV_LLM_MODEL=
STV_LLM_API_KEY=
# Paid text planning stays disabled until adapter/model/prices have been verified.
STV_LLM_ENABLED=false
STV_LLM_TOTAL_BUDGET_USD=1.00
STV_LLM_MAX_REQUEST_USD=0.05
STV_LLM_MAX_INPUT_BYTES=16000
STV_LLM_MAX_OUTPUT_TOKENS=1000
STV_LLM_PRICING_MODEL=
STV_LLM_INPUT_USD_PER_MILLION=
STV_LLM_OUTPUT_USD_PER_MILLION=
STV_MAX_JOB_CHARACTERS=20000
