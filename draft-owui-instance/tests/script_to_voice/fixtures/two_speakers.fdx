<?xml version="1.0" encoding="UTF-8"?>
<FinalDraft DocumentType="Script"><Content>
<Paragraph Type="Scene Heading" Number="12A"><Text>EXT. ROOFTOP - NIGHT</Text></Paragraph>
<Paragraph Type="Action"><Text>The radio clicks.</Text></Paragraph>
<Paragraph Type="Character"><Text>MIRA</Text></Paragraph>
<Paragraph Type="Parenthetical"><Text>(whispering)</Text></Paragraph>
<Paragraph Type="Dialogue"><Text>Channel </Text><Text Style="Italic">one</Text><Text> is clear. &#x1F319;</Text></Paragraph>
<Paragraph Type="Parenthetical"><Text>(hesitant)</Text></Paragraph>
<Paragraph Type="Dialogue"><Text>Are you sure?</Text></Paragraph>
<Paragraph Type="Character"><Text>JONAH</Text></Paragraph>
<Paragraph Type="Dialogue"><Text>Then we go.</Text></Paragraph>
<Paragraph Type="Scene Heading" Number="14"><Text>INT. CONTROL ROOM - DAY</Text></Paragraph>
<Paragraph Type="Character"><Text>MIRA (V.O.)</Text></Paragraph>
<Paragraph Type="Dialogue"><Text>Stay on channel one.</Text></Paragraph>
<Paragraph Type="Character"><Text>GUARD (NORTH)</Text></Paragraph>
<Paragraph Type="Dialogue"><Text>Who goes there?</Text></Paragraph>
</Content></FinalDraft>
