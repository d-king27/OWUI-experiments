{
  "manifest_version": 3,
  "name": "Open WebUI Guide Bridge",
  "description": "Adds a local Getting started entry point for the Open WebUI Guide proof of concept.",
  "version": "0.4.2",
  "content_scripts": [
    {
      "matches": [
        "http://localhost:3000/*",
        "http://127.0.0.1:3000/*"
      ],
      "js": [
        "bridge.js",
        "telemetry.js",
        "recipe-runner.js",
        "directive-renderer.js",
        "content.js"
      ],
      "css": [
        "guide.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "ui-map.json",
        "recipes.json"
      ],
      "matches": [
        "http://localhost:3000/*",
        "http://127.0.0.1:3000/*"
      ]
    }
  ]
}
