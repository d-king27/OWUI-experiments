{
  "schema_version": 1,
  "id": "open_webui_poc_recipe_registry",
  "recipes": [
    {
      "schema_version": 1,
      "id": "hello-world-demo",
      "title": "Try the Hello World connectivity example",
      "status": "draft",
      "description": "Selects the deterministic hello-world provider, submits a fixed test message, verifies the expected response, highlights it, and restores Open WebUI Guide.",
      "requires_confirmation": true,
      "confirmation": {
        "title": "Run the Hello World example?",
        "body": "The guide will select hello-world, type \"Test the connection\", submit it, wait for the fixed response, highlight the result, and then re-select Open WebUI Guide. Press Escape at any time to stop.",
        "confirm_label": "Run example",
        "cancel_label": "Cancel"
      },
      "allowed_origins": [
        "http://localhost:3000",
        "http://127.0.0.1:3000"
      ],
      "limits": {
        "total_timeout_ms": 45000,
        "default_step_timeout_ms": 5000,
        "cancel_key": "Escape"
      },
      "preconditions": [
        {
          "check": "selected_option",
          "target": "model-picker",
          "value": "Open WebUI Guide"
        },
        {
          "check": "option_available",
          "target": "model-picker",
          "value": "hello-world"
        },
        {
          "check": "target_available",
          "target": "message-composer"
        }
      ],
      "steps": [
        {
          "id": "open_model_picker",
          "action": "click",
          "target": "model-picker",
          "timeout_ms": 5000
        },
        {
          "id": "select_hello_world",
          "action": "choose_option",
          "target": "model-picker",
          "value": "hello-world",
          "match": "exact",
          "timeout_ms": 5000
        },
        {
          "id": "enter_test_message",
          "action": "type_fixed_text",
          "target": "message-composer",
          "value": "Test the connection",
          "clear_existing": true,
          "timeout_ms": 5000
        },
        {
          "id": "submit_test_message",
          "action": "click",
          "target": "send-button",
          "timeout_ms": 5000
        },
        {
          "id": "verify_fixed_response",
          "action": "wait_for_text",
          "target": "assistant-message",
          "value": "Hello, world! The baseline chat connection is working.",
          "match": "exact",
          "timeout_ms": 15000
        },
        {
          "id": "highlight_result",
          "action": "highlight",
          "target": "assistant-message",
          "duration_ms": 5000
        },
        {
          "id": "reopen_model_picker",
          "action": "click",
          "target": "model-picker",
          "timeout_ms": 5000
        },
        {
          "id": "restore_guide",
          "action": "choose_option",
          "target": "model-picker",
          "value": "Open WebUI Guide",
          "match": "exact",
          "timeout_ms": 5000
        }
      ],
      "on_success": {
        "message": "The fixed response confirms that Open WebUI exchanged a chat request with the hello-provider. It does not demonstrate language-model reasoning."
      },
      "on_failure": {
        "action": "stop",
        "clear_highlights": true,
        "message": "The expected fixed response did not appear. The example stopped without resubmitting the message or attempting further UI actions."
      },
      "on_cancel": {
        "action": "stop",
        "clear_highlights": true,
        "message": "The Hello World example was stopped. No further clicks or submissions were attempted."
      }
    },
    {
      "schema_version": 1,
      "id": "launch-getting-started",
      "title": "Open the Getting Started guide",
      "status": "draft",
      "description": "Starts a new chat, selects Open WebUI Guide, and submits the visible starter message used by the getting_started intent.",
      "trigger": {
        "intent": "getting_started",
        "source": "cta",
        "version": 1
      },
      "requires_confirmation": true,
      "confirmation": {
        "title": "Start a new guide chat?",
        "body": "Your current chat will not be changed. The guide will open in a new chat, select Open WebUI Guide, type the Getting Started prompt, and submit it.",
        "confirm_label": "Start guide",
        "cancel_label": "Cancel"
      },
      "allowed_origins": [
        "http://localhost:3000",
        "http://127.0.0.1:3000"
      ],
      "limits": {
        "total_timeout_ms": 30000,
        "default_step_timeout_ms": 5000,
        "cancel_key": "Escape"
      },
      "preconditions": [
        {
          "check": "target_available",
          "target": "new-chat"
        },
        {
          "check": "target_available",
          "target": "model-picker"
        },
        {
          "check": "option_available",
          "target": "model-picker",
          "value": "Open WebUI Guide"
        },
        {
          "check": "target_available",
          "target": "message-composer"
        }
      ],
      "steps": [
        {
          "id": "open_new_chat",
          "action": "click",
          "target": "new-chat",
          "timeout_ms": 5000
        },
        {
          "id": "wait_for_model_picker",
          "action": "wait_for_target",
          "target": "model-picker",
          "timeout_ms": 5000
        },
        {
          "id": "open_model_picker",
          "action": "click",
          "target": "model-picker",
          "timeout_ms": 5000
        },
        {
          "id": "select_guide",
          "action": "choose_option",
          "target": "model-picker",
          "value": "Open WebUI Guide",
          "match": "exact",
          "timeout_ms": 5000
        },
        {
          "id": "enter_starter_prompt",
          "action": "type_fixed_text",
          "target": "message-composer",
          "value": "Start the getting started tour",
          "clear_existing": true,
          "timeout_ms": 5000
        },
        {
          "id": "submit_starter_prompt",
          "action": "click",
          "target": "send-button",
          "timeout_ms": 5000
        },
        {
          "id": "wait_for_guide_response",
          "action": "wait_for_target",
          "target": "assistant-message",
          "timeout_ms": 15000
        }
      ],
      "on_failure": {
        "action": "stop",
        "clear_highlights": true,
        "preserve_current_page": true,
        "message": "The Getting Started guide could not be opened safely. No further actions were attempted."
      },
      "on_cancel": {
        "action": "stop",
        "clear_highlights": true,
        "message": "Getting Started was stopped."
      }
    }
  ]
}
